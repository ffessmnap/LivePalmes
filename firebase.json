            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public-firestore/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public-firestore/tops/**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public-firestore/tops-preview/**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public-firestore/swimmers/**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public-firestore/search/**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public-firestore/search/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public-firestore/ids/**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public-firestore/ids/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/resultats",
        "destination": "/resultats.html"
      },
      {
        "source": "/series",
        "destination": "/series-public.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".firebase/**",
      "functions/**",
      "docs/**",
      "tests/**",
      "tools/**",
      "tmp/**",
      "outputs/**",
      "firebase-backups/**",
      "performances/public/data/intranap-swimmer-perfs/**",
      "performances/public/data/intranap-top-source/**",
      "performances/public/data/intranap-swimmers-index.js",
      "performances/public/data/performance-base-migration-manifest.json",
      "archives/**",
      "sauvegardes/**",
      "sources/**",
      "ARCHITECTURE.md",
      "CHANGELOG.md",
      "FIREBASE_REGLES.md",
      "README.md",
      "TESTS_MANUELS.md"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
