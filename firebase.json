        ]
      },
      {
        "source": "/performances/public/data/performance-public/search/**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public/search/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public/ids/**/*.json",
        "headers": [
