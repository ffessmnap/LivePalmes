{
  "hosting": {
    "site": "livepalmes",
    "public": ".",
    "predeploy": [
      "node tools/sync-records-from-firestore.js --write"
    ],
    "redirects": [
      {
        "source": "/public.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/public",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/Public",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/Public.html",
        "destination": "/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/resultats",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/series",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/resultats.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/series-public.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/public.css",
