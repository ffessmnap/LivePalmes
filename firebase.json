          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public/tops/**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/performances/public/data/performance-public/tops-preview/**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
